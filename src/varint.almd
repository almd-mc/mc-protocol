import bytes

// Minecraft VarInt encoding (1-5 bytes, unsigned, LEB128).

fn encode(val: Int) -> Bytes = {
  var v = int.band(val, 0xFFFFFFFF)
  var buf = bytes.new(0)
  var done = false
  while not done {
    let byte = int.band(v, 0x7F)
    v = int.bshr(v, 7)
    if v > 0 then {
      bytes.push(buf, int.bor(byte, 0x80))
    } else {
      bytes.push(buf, byte)
      done = true
    }
  }
  buf
}

fn decode(buf: Bytes, offset: Int) -> { value: Int, size: Int } = {
  var val = 0
  var shift = 0
  var pos = offset
  var done = false
  while not done and pos < bytes.len(buf) {
    let b = bytes.read_u8(buf, pos)
    val = int.bor(val, int.bshl(int.band(b, 0x7F), shift))
    pos = pos + 1
    if int.band(b, 0x80) == 0 then { done = true } else { () }
    shift = shift + 7
  }
  { value: val, size: pos - offset }
}

// VarLong: 1-10 bytes, signed 64-bit.
// Same encoding as VarInt but up to 10 bytes.

fn encode_long(val: Int) -> Bytes = {
  var v = val
  var buf = bytes.new(0)
  var done = false
  while not done {
    let byte = int.band(v, 0x7F)
    v = int.bshr(v, 7)
    if v != 0 and v != -1 then {
      bytes.push(buf, int.bor(byte, 0x80))
    } else {
      bytes.push(buf, byte)
      done = true
    }
  }
  buf
}

fn decode_long(buf: Bytes, offset: Int) -> { value: Int, size: Int } = {
  var val = 0
  var shift = 0
  var pos = offset
  var done = false
  while not done and pos < bytes.len(buf) and shift < 70 {
    let b = bytes.read_u8(buf, pos)
    val = int.bor(val, int.bshl(int.band(b, 0x7F), shift))
    pos = pos + 1
    if int.band(b, 0x80) == 0 then { done = true } else { () }
    shift = shift + 7
  }
  { value: val, size: pos - offset }
}

// --- Tests ---

test "encode 0" { assert_eq(bytes.to_list(encode(0)), [0x00]) }
test "encode 1" { assert_eq(bytes.to_list(encode(1)), [0x01]) }
test "encode 127" { assert_eq(bytes.to_list(encode(127)), [0x7F]) }
test "encode 128" { assert_eq(bytes.to_list(encode(128)), [0x80, 0x01]) }
test "encode 255" { assert_eq(bytes.to_list(encode(255)), [0xFF, 0x01]) }
test "encode 25565" { assert_eq(bytes.to_list(encode(25565)), [0xDD, 0xC7, 0x01]) }
test "encode 767 (1.21.1 protocol)" { assert_eq(bytes.to_list(encode(767)), [0xFF, 0x05]) }

test "decode roundtrip" {
  for v in [0, 1, 127, 128, 255, 25565, 767, 65537] {
    let encoded = encode(v)
    let decoded = decode(encoded, 0)
    assert_eq(decoded.value, v)
    assert_eq(decoded.size, bytes.len(encoded))
  }
}

test "decode with offset" {
  let buf = bytes.from_list([0xFF, 0xFF, 0x05, 0x01])
  let r = decode(buf, 0)
  assert_eq(r.value, 98303)
  let r2 = decode(buf, r.size)
  assert_eq(r2.value, 1)
}
