import bytes
import self.varint
import self.types

// NeoForge-specific protocol encoding.
// ModdedNetworkQueryPayload, CommonVersionPayload, CommonRegisterPayload.

let PROTO_CONFIGURATION = 4

// ModdedNetworkQueryComponent: channel_id + version + flow(bidirectional) + optional(false)
fn encode_component(id: String, version: String) -> Bytes =
  bytes.concat(bytes.concat(types.encode_string(id), types.encode_string(version)), bytes.from_list([0x00, 0x00]))

// ModdedNetworkQueryPayload: Map<ConnectionProtocol, Set<Component>>
fn build_query_payload(channels: List[{ id: String, version: String }]) -> Bytes = {
  if list.is_empty(channels) then
    bytes.from_list([0x00])
  else {
    var buf = varint.encode(1)
    buf = bytes.concat(buf, varint.encode(PROTO_CONFIGURATION))
    buf = bytes.concat(buf, varint.encode(list.length(channels)))
    for ch in channels {
      buf = bytes.concat(buf, encode_component(ch.id, ch.version))
    }
    buf
  }
}

// CommonVersionPayload: List<Integer>
fn build_version_response(version: Int) -> Bytes =
  bytes.concat(varint.encode(1), varint.encode(version))

// CommonRegisterPayload: version + protocol + channels
fn build_register_response() -> Bytes =
  bytes.concat(bytes.concat(varint.encode(1), types.encode_string("play")), varint.encode(0))

// --- Tests ---

test "query payload - empty" {
  assert_eq(bytes.to_list(build_query_payload([])), [0x00])
}

test "query payload - 2 channels" {
  let payload = build_query_payload([
    { id: "aoa3:player_halos_sync", version: "aoa3" },
    { id: "aoa3:skill_reqs_sync", version: "aoa3" },
  ])
  assert_eq(bytes.len(payload), 61)
  // Map size = 1
  assert_eq(bytes.read_u8(payload, 0), 0x01)
  // Protocol = CONFIGURATION (4)
  assert_eq(bytes.read_u8(payload, 1), 0x04)
  // Set size = 2
  assert_eq(bytes.read_u8(payload, 2), 0x02)
}

test "version response" {
  let resp = build_version_response(1)
  assert_eq(bytes.to_list(resp), [0x01, 0x01])
}
